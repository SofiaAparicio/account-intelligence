# Copy to .env and fill in ONE provider. The app picks the first key it finds.
# All of these have a free tier.

# Groq (fast, free, no card): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama (local, no key). Set the model name if you use it.
OLLAMA_MODEL=

# Optional: override the model used by the chosen provider
LLM_MODEL=
